---
import Base from '../layouts/Base.astro';
import { palette, domande, linkWhatsApp } from '../data/natale';
---
<Base
  title="Come vestirsi per il set di Natale · e le domande"
  description="La palette del set di Natale 2026 (avorio, corda, cammello, verde bosco, bordeaux, noce), cosa funziona, cosa evitare e le risposte alle domande più frequenti."
  pagina="vestirsi"
  messaggio="Ciao Elisabetta, ti mando una foto dei vestiti per il set di Natale"
>
  <section class="sezione wrap pila" style="gap:14px">
    <p class="occhiello">Come vestirvi</p>
    <h1 class="h1">I colori del set</h1>
    <p class="lead stretto">Me lo chiedete in tanti, quindi ve lo scrivo qui. Il set di quest'anno è legno, lucine, rami e una porta rossa: stanno benissimo i colori caldi e naturali, quelli della palette qui sotto.</p>
  </section>

  <section class="wrap" aria-label="La palette dei colori">
    <ul class="palette">
      {palette.map((c) => (
        <li><span class="campione" style={`background:${c.hex}`}></span><span class="nome">{c.nome}</span></li>
      ))}
    </ul>
    <p class="piccolo nota">caldi e naturali, come il legno e le lucine</p>
  </section>

  <section class="sezione wrap consigli">
    <div class="pila" style="gap:10px">
      <p class="occhiello">Un consiglio</p>
      <p>Non serve essere tutti uguali: basta restare dentro i colori della palette, ognuno il suo, e la foto viene armoniosa da sola.</p>
    </div>
    <div class="pila" style="gap:10px">
      <p class="occhiello">Funzionano</p>
      <p>Maglioni di lana e a trecce, velluto, flanella, camicie. Un solo capo a quadri scozzesi per famiglia.</p>
    </div>
    <div class="pila" style="gap:10px">
      <p class="occhiello">Meglio evitare</p>
      <p>Il bianco ottico e il nero totale, i colori fluo e quelli freddi, le scritte, i loghi grandi e i personaggi dei cartoni.</p>
    </div>
  </section>

  <section class="wrap stretto dubbio pila">
    <h2>Un dubbio?</h2>
    <p>Mandatemi una foto dei vestiti prima della sessione e li guardiamo insieme.</p>
    <p><a class="bottone" href={linkWhatsApp('Ciao Elisabetta, ti mando una foto dei vestiti per il set di Natale')} rel="noopener">Mandami la foto dei vestiti</a></p>
  </section>

  <section class="sezione wrap stretto" id="domande" aria-labelledby="titolo-domande">
    <div class="pila" style="gap:24px">
      <p class="occhiello">Le domande</p>
      <h2 id="titolo-domande">Quello che mi chiedete più spesso</h2>
      <div class="fisarmonica">
        {domande.map((q) => (
          <details>
            <summary>{q.d}</summary>
            <p>{q.r}</p>
          </details>
        ))}
      </div>
      <p class="piccolo">Non trovate la vostra domanda? Scrivetemi: vi rispondo io.</p>
    </div>
  </section>
</Base>

<style>
  .h1{font:italic 500 clamp(54px,8vw,96px)/.95 var(--display)}
  .palette{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(6,1fr);gap:12px}
  .palette li{display:grid;gap:10px}
  .campione{display:block;aspect-ratio:3 / 4;border:1px solid var(--filetto)}
  .nome{font:italic 500 21px/1.1 var(--display);text-align:center}
  .nota{text-align:center;margin-top:18px;font-style:italic}
  .consigli{display:grid;grid-template-columns:repeat(3,1fr);gap:34px}
  .consigli > div{padding-top:16px;border-top:1px solid var(--bordeaux)}
  .dubbio{background:var(--carta);border:1px solid var(--filetto);padding:32px max(24px,var(--gutter));text-align:center;align-items:center;margin-bottom:10px}
  .fisarmonica{border-top:1px solid var(--bordeaux)}
  details{border-bottom:1px solid var(--filetto)}
  summary{cursor:pointer;list-style:none;display:flex;justify-content:space-between;gap:18px;align-items:baseline;padding-block:18px;font:500 24px/1.25 var(--display);color:var(--testo)}
  summary::-webkit-details-marker{display:none}
  summary::after{content:"+";font:300 26px/1 var(--sans);color:var(--bordeaux);transition:transform .25s ease}
  details[open] summary::after{transform:rotate(45deg)}
  details p{padding-bottom:20px;max-width:62ch}
  @media (max-width:820px){.palette{grid-template-columns:repeat(3,1fr)}.consigli{grid-template-columns:1fr;gap:24px}}
</style>
