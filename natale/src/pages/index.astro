---
import Base from '../layouts/Base.astro';
---
<Base title="Natale 2026 · Elisabetta Acquaviva">
  <main class="pagina">
    <div class="barra"><span>Edizione di Natale</span><span>N° 2026</span></div>
    <h1>Natale</h1>
    <p class="sotto">è alle porte.</p>
    <p class="nota">Questa pagina sta nascendo.</p>
  </main>
</Base>

<style>
  .pagina{max-width:760px;margin:0 auto;padding:40px max(16px, env(safe-area-inset-left, 0px)) 64px max(16px, env(safe-area-inset-right, 0px))}
  .barra{display:flex;justify-content:space-between;gap:12px;border-block:1px solid var(--bordeaux);padding-block:9px;font:600 11px/1 var(--sans);letter-spacing:.22em;text-transform:uppercase;color:var(--bordeaux)}
  h1{font:italic 500 clamp(64px,16vw,140px)/1 var(--display);color:var(--bordeaux);margin:48px 0 0}
  .sotto{font:500 clamp(28px,6vw,48px)/1.1 var(--display);color:var(--bordeaux);text-align:right;margin:4px 0 0}
  .nota{margin-top:56px;padding-top:14px;border-top:1px solid var(--filetto);font:italic 22px/1.4 var(--display)}
</style>
