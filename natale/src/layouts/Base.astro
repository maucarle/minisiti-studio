---
// Stile "Diario d'inverno": lo stile B dello studio (reel, pieghevole, home di Natale), su crema caldo.
import { APERTO, contatti, linkWhatsApp } from '../data/natale';

interface Props { title: string; description: string; pagina: string; messaggio?: string }
const { title, description, pagina, messaggio = 'Ciao Elisabetta, ho visto la pagina del Natale e vorrei prenotare' } = Astro.props;

const voci = [
  { href: '/', id: 'set', nome: 'Il set' },
  { href: '/sessioni/', id: 'sessioni', nome: 'Le proposte' },
  { href: '/ritratto/', id: 'ritratto', nome: 'Il ritratto' },
  { href: '/regala/', id: 'regala', nome: 'Regalarlo' },
  { href: '/idee-regalo/', id: 'idee', nome: 'Idee regalo' },
  { href: '/come-vestirsi/', id: 'vestirsi', nome: 'Come vestirsi' },
];
const canonico = new URL(Astro.url.pathname, Astro.site).href;
---
<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {APERTO ? <link rel="canonical" href={canonico} /> : <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="it_IT" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonico} />
    <meta name="theme-color" content="#F5F0E4" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/CormorantGaramond-Italic.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/Inter.woff2" as="font" type="font/woff2" crossorigin />
    <style is:global>
      @font-face{font-family:'Cormorant Garamond';src:url(/fonts/CormorantGaramond.woff2) format('woff2');font-weight:300 700;font-display:swap}
      @font-face{font-family:'Cormorant Garamond';src:url(/fonts/CormorantGaramond-Italic.woff2) format('woff2');font-style:italic;font-weight:300 700;font-display:swap}
      @font-face{font-family:'Inter';src:url(/fonts/Inter.woff2) format('woff2');font-weight:100 900;font-display:swap}
      :root{
        --crema:#F5F0E4; --carta:#EFE6D2; --carta-2:#E9DEC6; --filetto:#D8CFBF; --testo:#3A3330; --tenue:#6B625B;
        --bordeaux:#6E191F; --bordeaux-scuro:#561318; --bosco:#1E3A2A; --oro:#C9A77E; --oro-chiaro:#E3C7A6; --noce:#2A1E17;
        --display:'Cormorant Garamond', Georgia, 'Times New Roman', serif;
        --sans:'Inter', system-ui, -apple-system, 'Helvetica Neue', Arial, sans-serif;
        --gutter:max(18px, env(safe-area-inset-left, 0px));
        --gutter-d:max(18px, env(safe-area-inset-right, 0px));
        --colonna:1120px;
        color-scheme:light;
      }
      *,*::before,*::after{box-sizing:border-box}
      html{-webkit-text-size-adjust:100%;scroll-behavior:smooth}
      @media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}*{animation:none!important;transition:none!important}}
      body{margin:0;background:var(--crema);color:var(--testo);font:17px/1.65 var(--sans);text-rendering:optimizeLegibility}
      img{max-width:100%;height:auto;display:block;-webkit-touch-callout:none;-webkit-user-select:none;user-select:none}
      a{color:var(--bordeaux);text-underline-offset:3px;text-decoration-thickness:1px}
      a:hover{color:var(--bordeaux-scuro)}
      :focus-visible{outline:2px solid var(--bordeaux);outline-offset:3px}
      h1,h2,h3{font-family:var(--display);font-weight:500;line-height:1.08;text-wrap:balance;margin:0;color:var(--bordeaux)}
      h2{font-size:clamp(34px,5.4vw,54px)}
      h3{font-size:clamp(25px,3vw,30px)}
      p{margin:0}
      .wrap{max-width:var(--colonna);margin:0 auto;padding-left:var(--gutter);padding-right:var(--gutter-d)}
      .stretto{max-width:720px}
      .occhiello{font:600 11px/1.2 var(--sans);letter-spacing:.24em;text-transform:uppercase;color:var(--bordeaux)}
      .lead{font-family:var(--display);font-size:clamp(22px,2.9vw,27px);line-height:1.42;color:var(--testo)}
      .pila{display:flex;flex-direction:column;gap:18px}
      .sezione{padding-block:clamp(52px,8vw,96px)}
      .sezione + .sezione{border-top:1px solid var(--filetto)}
      .piccolo{font-size:14.5px;color:var(--tenue)}
      .bottone{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:50px;padding:14px 26px;background:var(--bosco);color:var(--crema);font:600 12.5px/1.2 var(--sans);letter-spacing:.18em;text-transform:uppercase;text-decoration:none;border:0;cursor:pointer;transition:background .2s ease}
      .bottone:hover{background:#13281c;color:var(--crema)}
      .bottone.chiaro{background:transparent;color:var(--bordeaux);box-shadow:inset 0 0 0 1px var(--bordeaux)}
      .bottone.chiaro:hover{background:var(--bordeaux);color:var(--crema)}
      .citazione{font-family:var(--display);font-style:italic;font-size:clamp(21px,2.4vw,24px);line-height:1.4}
      .citazione + .chi{margin-top:8px;font:600 11px/1 var(--sans);letter-spacing:.18em;text-transform:uppercase;color:var(--tenue)}
      .appare{animation:appare .9s ease both}
      @keyframes appare{from{opacity:.55;transform:translateY(8px)}to{opacity:1;transform:none}}
    </style>
  </head>
  <body>
    <header class="testata">
      <div class="wrap">
        <div class="barra"><a class="marchio" href={contatti.sito}>Elisabetta Acquaviva <span>fotografa · Rimini</span></a><span class="occhiello numero">Edizione di Natale · N° 2026</span></div>
      </div>
      <nav class="menu" aria-label="Le pagine del Natale">
        <ul class="wrap">
          {voci.map((v) => (
            <li><a href={v.href} aria-current={v.id === pagina ? 'page' : undefined}>{v.nome}</a></li>
          ))}
        </ul>
      </nav>
    </header>

    <main><slot /></main>

    <footer class="piede">
      <div class="wrap griglia-piede">
        <div class="pila" style="gap:10px">
          <p class="firma">Vi aspetto!!<br /><em>Eli</em></p>
        </div>
        <div class="pila" style="gap:6px">
          <span class="occhiello" style="color:var(--oro-chiaro)">Prenotazioni</span>
          <a href={linkWhatsApp(messaggio)} rel="noopener">WhatsApp {contatti.telefono}</a>
          <a href={`tel:+39${contatti.telefono.replace(/\s/g, '')}`}>Telefono {contatti.telefono}</a>
          <a href={`mailto:${contatti.email}`}>{contatti.email}</a>
        </div>
        <div class="pila" style="gap:6px">
          <span class="occhiello" style="color:var(--oro-chiaro)">Lo studio</span>
          <a href={contatti.mappa} rel="noopener">{contatti.indirizzo}</a>
          <a href={contatti.sito}>elisabettacquaviva.it</a>
          <a href={contatti.instagram} rel="noopener">Instagram</a>
        </div>
      </div>
    </footer>

    <a class="barra-prenota" href={linkWhatsApp(messaggio)} rel="noopener">Prenota su WhatsApp</a>

    <style>
      .testata{border-bottom:1px solid var(--filetto);background:var(--crema)}
      .barra{display:flex;justify-content:space-between;align-items:baseline;gap:16px;flex-wrap:wrap;padding-block:16px 12px;border-bottom:1px solid var(--bordeaux)}
      .marchio{font:500 21px/1.1 var(--display);color:var(--testo);text-decoration:none}
      .marchio span{display:block;font:500 10.5px/1.6 var(--sans);letter-spacing:.2em;text-transform:uppercase;color:var(--tenue)}
      .menu{position:sticky;top:0;z-index:5;background:var(--crema)}
      .menu ul{list-style:none;margin:0 auto;display:flex;gap:4px 26px;overflow-x:auto;scrollbar-width:none;padding-block:12px}
      .menu ul::-webkit-scrollbar{display:none}
      .menu a{white-space:nowrap;font:500 13px/1.6 var(--sans);letter-spacing:.06em;color:var(--testo);text-decoration:none;padding-block:4px;border-bottom:1px solid transparent}
      .menu a:hover{color:var(--bordeaux)}
      .menu a[aria-current="page"]{color:var(--bordeaux);border-bottom-color:var(--bordeaux)}
      .piede{background:var(--bosco);color:var(--crema);padding-block:56px calc(110px + env(safe-area-inset-bottom, 0px))}
      .piede a{color:var(--crema);text-decoration:none;font-size:15px}
      .piede a:hover{color:var(--oro-chiaro)}
      .griglia-piede{display:grid;grid-template-columns:1.2fr 1fr 1fr;gap:32px}
      .firma{font:italic 500 34px/1.15 var(--display);color:var(--oro-chiaro)}
      .barra-prenota{position:fixed;left:0;right:0;bottom:0;z-index:10;display:flex;justify-content:center;align-items:center;min-height:56px;padding:10px var(--gutter-d) calc(10px + env(safe-area-inset-bottom, 0px)) var(--gutter);background:var(--bordeaux);color:var(--crema);font:600 13px/1 var(--sans);letter-spacing:.18em;text-transform:uppercase;text-decoration:none;box-shadow:0 -8px 24px -16px rgba(40,10,10,.6)}
      .barra-prenota:hover{color:var(--crema);background:var(--bordeaux-scuro)}
      @media (max-width:760px){.griglia-piede{grid-template-columns:1fr}.numero{display:none}}
      @media (min-width:761px){.barra-prenota{display:none}.piede{padding-bottom:56px}}
    </style>
  </body>
</html>
