---
// L'apertura «vedo non vedo» del reel di lancio, ricreata dal vivo: il set dietro un vetro opalino,
// due barre più trasparenti che si incrociano e, nel quadrato d'incrocio, il set nitido.
// Dopo qualche incrocio il vetro si apre. Livelli e clip-path in CSS (niente filtri canvas, che Safari iPhone non garantisce).
// Valori del reel scelti da Mauro: barre al 25% della larghezza, attraversamento 4 s, opalino 47%, traccia 13%, pausa 1,8 s.
import fs from 'node:fs';
import path from 'node:path';

// foto: un file in public/foto (es. 'set/compagnia.jpg'); fuoco: il punto che resta al centro quando il riquadro taglia (sul telefono è 4:5)
interface Props { alt: string; nota?: string; foto?: string; fuoco?: string }
const { alt, nota, foto = 'set/set-01.jpg', fuoco = '62% 50%' } = Astro.props;
// Se la foto vera non c'è ancora si usa l'immagine di riferimento.
const vera = fs.existsSync(path.join(process.cwd(), 'public', 'foto', foto));
const src = vera ? `/foto/${foto}` : '/foto/riferimento/set.jpg';
---
<figure class="vnv" data-vnv style={`--fuoco:${fuoco}`}>
  <div class="scena">
    <img class="strato sfocato" src={src} alt="" aria-hidden="true" decoding="async" fetchpriority="high" />
    <div class="strato opale"></div>
    <div class="strato traccia" aria-hidden="true"><img src={src} alt="" decoding="async" /><span></span></div>
    <img class="strato nitido" src={src} alt={alt} decoding="async" draggable="false" />
    <img class="strato svelato" src={src} alt="" aria-hidden="true" decoding="async" draggable="false" />
  </div>
  {!vera && nota && <figcaption>{nota}</figcaption>}
</figure>

<script>
  const ambienti = document.querySelectorAll<HTMLElement>('[data-vnv]');
  const fermo = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Seme fisso, come nel reel: la sequenza degli incroci è sempre la stessa.
  function rng(s: number) { return () => { s |= 0; s = (s + 0x6d2b79f5) | 0; let t = Math.imul(s ^ (s >>> 15), 1 | s); t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t; return ((t ^ (t >>> 14)) >>> 0) / 4294967296; }; }

  ambienti.forEach((el) => {
    const scena = el.querySelector<HTMLElement>('.scena')!;
    const modelloTraccia = el.querySelector<HTMLElement>('.traccia')!;
    const modelloNitido = el.querySelector<HTMLElement>('.nitido')!;
    if (fermo) { el.classList.add('aperto'); return; }

    const LARGHEZZA = 0.25, ATTRAVERSAMENTO = 4, PAUSA = 1.8, INCROCI = 3;
    const R = rng(7);
    let tc = 0.9;
    const incroci = Array.from({ length: INCROCI }, () => {
      const k = { tc, cx: 0.18 + 0.64 * R(), cy: 0.2 + 0.6 * R(), dx: R() < 0.5 ? 1 : -1, dy: R() < 0.5 ? 1 : -1, traccia: modelloTraccia, nitido: modelloNitido };
      tc += PAUSA * (0.75 + 0.5 * R());
      return k;
    });
    // ogni incrocio ha i suoi due livelli: più incroci possono essere a schermo insieme, come nel reel
    incroci.forEach((k, i) => {
      if (i === 0) return;
      k.traccia = modelloTraccia.cloneNode(true) as HTMLElement;
      k.nitido = modelloNitido.cloneNode(true) as HTMLElement;
      k.nitido.setAttribute('alt', '');
      k.nitido.setAttribute('aria-hidden', 'true');
      modelloNitido.before(k.traccia);
      scena.querySelector('.svelato')!.before(k.nitido);
    });
    const fine = incroci[INCROCI - 1].tc + 1.1;
    let t0 = 0, visibile = true, raf = 0, finito = false;

    function croce(x: number, y: number, w: number, W: number, H: number) {
      const a = x - w / 2, b = x + w / 2, c = y - w / 2, d = y + w / 2;
      return `polygon(${a}px 0,${b}px 0,${b}px ${c}px,${W}px ${c}px,${W}px ${d}px,${b}px ${d}px,${b}px ${H}px,${a}px ${H}px,${a}px ${d}px,0 ${d}px,0 ${c}px,${a}px ${c}px)`;
    }

    function fotogramma(ora: number) {
      if (!t0) t0 = ora;
      const t = (ora - t0) / 1000;
      const W = scena.clientWidth, H = scena.clientHeight, w = W * LARGHEZZA;
      const v = Math.max(W, H) / ATTRAVERSAMENTO;
      for (const k of incroci) {
        const dt = t - k.tc;
        if (Math.abs(dt) * v > Math.max(W, H) * 1.2) { k.traccia.style.clipPath = k.nitido.style.clipPath = 'inset(50%)'; continue; }
        const x = k.cx * W + k.dx * v * dt, y = k.cy * H + k.dy * v * dt;
        k.traccia.style.clipPath = croce(x, y, w, W, H);
        k.nitido.style.clipPath = `inset(${y - w / 2}px ${W - x - w / 2}px ${H - y - w / 2}px ${x - w / 2}px)`;
      }
      if (t >= fine) { finito = true; el.classList.add('aperto'); return; }
      if (visibile) raf = requestAnimationFrame(fotogramma);
    }

    // Si muove solo quando si vede: niente lavoro inutile fuori schermo.
    new IntersectionObserver(([e]) => {
      visibile = e.isIntersecting;
      if (visibile && !finito) { cancelAnimationFrame(raf); raf = requestAnimationFrame(fotogramma); }
    }).observe(scena);
  });
</script>

<style>
  .vnv{margin:0;display:grid;gap:10px}
  .scena{position:relative;overflow:hidden;aspect-ratio:1381 / 752;background:var(--carta);isolation:isolate}
  .strato{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:var(--fuoco)}
  img.strato{-webkit-touch-callout:none;user-select:none;pointer-events:none}
  .sfocato{filter:blur(16px) saturate(.9);transform:scale(1.08)}
  .opale{background:rgba(244,240,234,.47)}
  .traccia{opacity:.13;clip-path:inset(50% 50% 50% 50%)}
  .traccia img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:var(--fuoco);filter:blur(16px);transform:scale(1.08)}
  .traccia span{position:absolute;inset:0;background:rgba(244,240,234,.26)}
  .nitido{clip-path:inset(50% 50% 50% 50%);will-change:clip-path}
  .svelato{opacity:0;transition:opacity 1.6s cubic-bezier(.4,0,.2,1)}
  .aperto .svelato{opacity:1}
  figcaption{font:italic 16px/1.3 var(--display);color:var(--tenue)}
  @media (max-width:640px){.scena{aspect-ratio:4 / 5}}
</style>
